<UserControl x:Class="PcTuner.Views.NetworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26" MaxWidth="920">
            <TextBlock Style="{StaticResource PageTitle}" Text="Rede" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Mede ping, velocidade e bufferbloat: o quanto o ping sobe quando a conexão está ocupada. É isso que causa lag quando alguém baixa algo enquanto você joga. Leva cerca de 30 segundos." />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="Iniciar teste" Click="Start_Click" />
                <TextBlock x:Name="ProgressText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource Muted}" />
            </StackPanel>

            <StackPanel x:Name="Results" Visibility="Collapsed">
                <UniformGrid Columns="3">
                    <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetricLabel}" Text="Download" />
                            <TextBlock x:Name="DownloadValue" Style="{StaticResource MetricValue}" />
                            <TextBlock x:Name="DownloadDetail" Style="{StaticResource CardText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetricLabel}" Text="Upload" />
                            <TextBlock x:Name="UploadValue" Style="{StaticResource MetricValue}" />
                            <TextBlock x:Name="UploadDetail" Style="{StaticResource CardText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetricLabel}" Text="Ping (conexão livre)" />
                            <TextBlock x:Name="PingValue" Style="{StaticResource MetricValue}" />
                            <TextBlock x:Name="PingDetail" Style="{StaticResource CardText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetricLabel}" Text="Bufferbloat no download" />
                            <TextBlock x:Name="DownGradeValue" Style="{StaticResource MetricValue}" />
                            <TextBlock x:Name="DownGradeDetail" Style="{StaticResource CardText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetricLabel}" Text="Bufferbloat no upload" />
                            <TextBlock x:Name="UpGradeValue" Style="{StaticResource MetricValue}" />
                            <TextBlock x:Name="UpGradeDetail" Style="{StaticResource CardText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetricLabel}" Text="Roteador (Wi-Fi ou cabo)" />
                            <TextBlock x:Name="GatewayValue" Style="{StaticResource MetricValue}" />
                            <TextBlock x:Name="GatewayDetail" Style="{StaticResource CardText}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="O que isso quer dizer" />
                        <TextBlock x:Name="Verdict" Style="{StaticResource CardText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
