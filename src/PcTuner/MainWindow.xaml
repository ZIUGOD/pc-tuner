<Window x:Class="PcTuner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Tuner" Width="1080" Height="760" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="Width" Value="24" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menu lateral -->
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="26,26,20,28">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="pc_tuner" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                        <TextBlock x:Name="BlinkCursor" Text="█" FontSize="20" Foreground="{StaticResource Accent}" Margin="2,0,0,0">
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:1.2">
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="0" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource Faint}" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Rodapé do menu: uso do disco C: -->
                <StackPanel DockPanel.Dock="Bottom" Margin="26,0,22,22">
                    <TextBlock Foreground="{StaticResource Faint}" FontSize="11">
                        <Run Text="&#xF0A0;" /> <Run Text="disco C:" />
                    </TextBlock>
                    <ProgressBar x:Name="DiskBar" Margin="0,8,0,6" Maximum="1" />
                    <TextBlock x:Name="DiskText" Foreground="{StaticResource Muted}" FontSize="11" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="// menu" Foreground="{StaticResource Faint}" FontSize="11" Margin="26,0,0,8" />
                    <RadioButton x:Name="NavOverview" Style="{StaticResource NavButton}" Tag="overview" AutomationProperties.Name="Visão geral" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xF0E4;" /><TextBlock Text="Visão geral" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" Tag="tweaks" AutomationProperties.Name="Otimizações" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xF1DE;" /><TextBlock Text="Otimizações" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" Tag="network" AutomationProperties.Name="Rede" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xF1EB;" /><TextBlock Text="Rede" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" Tag="startup" AutomationProperties.Name="Inicialização" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xF135;" /><TextBlock Text="Inicialização" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" Tag="clean" AutomationProperties.Name="Limpeza" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xF1F8;" /><TextBlock Text="Limpeza" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" Tag="disk" AutomationProperties.Name="Espaço em disco" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xF07B;" /><TextBlock Text="Espaço em disco" /></StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Conteúdo -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Bottom" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,1,0,0" Padding="22,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Click="OpenHistory_Click" Padding="12,4">
                        <TextBlock><Run Text="&#xF1DA;" /> <Run Text="histórico" /></TextBlock>
                    </Button>
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0">
                        <Run Text="$" Foreground="{StaticResource Accent}" FontWeight="Bold" />
                        <Run x:Name="StatusText" Text="pronto." Foreground="{StaticResource Muted}" />
                    </TextBlock>
                </DockPanel>
            </Border>
            <ContentControl x:Name="PageHost" Focusable="False" />
        </DockPanel>
    </Grid>
</Window>
