<UserControl x:Class="PcTuner.Views.TweaksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26" MaxWidth="920">
            <TextBlock Style="{StaticResource PageTitle}" Text="Otimizações" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Ligado = ajuste aplicado. Desligar volta ao padrão do Windows. Cada mudança fica no histórico." />
            <TextBlock x:Name="Loading" Foreground="{StaticResource Muted}" Text="Verificando o que existe neste PC..." />

            <ItemsControl x:Name="Sections">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding Name}" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <WrapPanel>
                                                        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" />
                                                        <Border Margin="8,1,0,0" Padding="7,1" CornerRadius="8" VerticalAlignment="Center"
                                                                Background="{Binding BadgeBackground}">
                                                            <TextBlock FontSize="11" Text="{Binding BadgeText}" Foreground="{Binding BadgeForeground}" />
                                                        </Border>
                                                    </WrapPanel>
                                                    <TextBlock Style="{StaticResource CardText}" Text="{Binding Description}" />
                                                    <TextBlock Style="{StaticResource CautionText}" Text="{Binding WarningText}"
                                                               Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center" MinWidth="70">
                                                    <CheckBox Style="{StaticResource Toggle}" HorizontalAlignment="Center"
                                                              IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" />
                                                    <TextBlock HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="11"
                                                               Foreground="{StaticResource Muted}" Text="{Binding StateText}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
