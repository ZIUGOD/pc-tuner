<UserControl x:Class="PcTuner.Views.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26" MaxWidth="920">
            <TextBlock Style="{StaticResource Prompt}" Text="root@pc-tuner:~$ ./inicializacao --listar" />
            <TextBlock Style="{StaticResource PageTitle}" Text="Inicialização" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Programas que abrem junto com o Windows. Desligar não desinstala nada: o programa continua abrindo normalmente quando você clicar nele." />

            <ItemsControl x:Name="Entries">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource CardText}" FontSize="11" Text="{Binding Command}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center" MinWidth="110">
                                    <CheckBox Style="{StaticResource Toggle}" HorizontalAlignment="Center"
                                              IsChecked="{Binding IsOn, Mode=TwoWay}" />
                                    <TextBlock HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="11"
                                               Foreground="{StaticResource Muted}" Text="{Binding StateText}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
